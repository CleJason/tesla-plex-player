# Tesla Plex Player Configuration

# Port to bind
PORT=3355

# Plex Media Server URL (e.g., http://192.168.1.100:32400 or https://plex.yourdomain.com)
PLEX_SERVER_URL=http://192.168.1.100:32400

# Your secret Plex token (kept strictly server-side, never sent to the browser)
# See README.md on how to obtain your X-Plex-Token
PLEX_TOKEN=your_plex_token_here

# Optional: Music Library Section ID
# If left blank, the app will automatically query /library/sections and use the first music section
PLEX_MUSIC_SECTION_ID=

# Cellular Optimization & Transcoding
# Setting to true transcodes FLAC/ALAC/unsupported codecs to MP3 to ensure compatibility and prevent cellular buffering
TRANSCODE_AUDIO=false

# Audio bitrate in kbps for transcoded stream (192 or 256 recommended for mobile cellular data)
AUDIO_BITRATE=192

# Authentication & Security
# The single allowed Plex account ID or username permitted to log in
# See README.md on how to discover your Plex user ID
ALLOWED_PLEX_USER_ID=your_plex_account_id_here

# Secret string used to sign session cookies (generate any random string)
SESSION_SECRET=change_this_to_a_long_random_secret_string

# Set to true when serving over HTTPS (via reverse proxy) so the cookie gets the secure flag
# In local development over plain HTTP, leave false or unset
COOKIE_SECURE=false

# Enable offline mock data mode for testing without a live Plex server (true/false)
USE_MOCK_PLEX=false
